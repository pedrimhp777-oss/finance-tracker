DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=generate-a-long-random-secret-before-deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=https://your-finance-tracker.vercel.app


# Monitoramento de erros (opcional). Sem SENTRY_DSN, nada e enviado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Performance tracing desligado por padrao (0 = off).
SENTRY_TRACES_SAMPLE_RATE=0

# Recuperacao de senha (link enviado por e-mail)
# Base do link: o frontend abre /?reset_token=...
PASSWORD_RESET_URL=https://finance-tracker-front-pearl.vercel.app
PASSWORD_RESET_TTL_MINUTES=30
# Provedor de e-mail. BREVO tem prioridade sobre RESEND se ambos existirem.
# Brevo: permite verificar UM endereco (sem dominio proprio) - plano free 300/dia.
BREVO_API_KEY=
# Alternativa: Resend (exige dominio verificado para enviar a qualquer usuario).
RESEND_API_KEY=
# Aceita "Nome <email>" ou apenas "email". O endereco precisa estar
# verificado no provedor escolhido.
EMAIL_FROM=Finance Tracker <seu-email@gmail.com>
